{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/tanzu-platform-1",
      "destination": "/tanzu-platform",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}